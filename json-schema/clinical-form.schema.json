{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zarishhealth.github.io/api/json-schema/clinical-form.schema.json",
  "title": "Clinical form",
  "description": "A form definition: the fields one workflow screen collects. One file per form, under content/forms/<service-code>/.",
  "type": "object",
  "properties": {
    "formId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable identifier of the form, kebab-case."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Increases when the form changes; a submission records the version it used."
    },
    "serviceCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "The unique service code this form belongs to."
    },
    "title": {
      "type": "object",
      "description": "Translated titles, keyed by BCP 47 language tag.",
      "additionalProperties": { "type": "string" }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "required": ["formId", "version", "serviceCode", "title", "fields"],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "Key of the field within the form, camelCase."
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "date", "dateTime", "code", "quantity", "reference"]
        },
        "required": { "type": "boolean" },
        "label": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "codeSystem": {
          "type": "string",
          "description": "Canonical URL of the value set or code system, when the type is code."
        }
      },
      "required": ["name", "type", "label"],
      "additionalProperties": false
    }
  }
}
